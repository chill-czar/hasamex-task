# Google GenAI / Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration
# Local SQLite fallback: sqlite:///hasamex.db
# PostgreSQL: postgresql://hasamex:hasamex_password@localhost:5432/hasamex_db
DATABASE_URL=sqlite:///hasamex.db

# Optional Managed File Search Store ID (will auto-create if empty)
FILE_SEARCH_STORE_ID=

# Environment
ENVIRONMENT=development

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
